# Development-only defaults. No Azure credentials or external object store needed.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=schulddossier-local-development-only
DATABASE_URL=pgsql://schulddossier:insecure@postgres:5432/schulddossier?serverVersion=15&charset=utf8
MAILER_DSN=smtp://mailpit:1025
APP_NOTIFICATIE_FROM=test@amsterdam.nl
IAM_CLIENT_ID=schulddossier
IAM_CLIENT_SECRET=insecure
IAM_URL=http://keycloak.schulddossier.test:8084/realms/schulddossier
IAM_LOGOUT_URL=http://keycloak.schulddossier.test:8084/realms/schulddossier/protocol/openid-connect/logout
FEATUREFLAG_HERFINANCIERING=1
ALLEGRO_ENDPOINT=http://127.0.0.1:9/SOAP
ALLEGRO_ONBEKENDE_SCHULDEISER=0
